# Copy to .env and fill in. .env is gitignored — never commit real values.

# Bridge IP of the lnd container, as seen from the container running this app.
LND_REST_HOST=
LND_REST_PORT=8009

# Hex-encoded readonly macaroon (least privilege — getinfo only needs read).
# xxd -ps -u -c 1000 ~/.lnd/data/chain/bitcoin/mainnet/readonly.macaroon
LND_MACAROON_HEX=

# Optional: base64 of lnd's tls.cert. If set, TLS is verified against it;
# if unset, the self-signed cert is accepted without verification.
# base64 -w0 ~/.lnd/tls.cert
LND_TLS_CERT_B64=

# Minibits watchdog API, as seen from the container running this app. It is not
# published to the internet: the browser only ever reaches /api/watchdog, which
# reads this address server-side and returns a reduced, 5-minute-cached subset.
WATCHDOG_API_HOST=
WATCHDOG_API_PORT=3005
