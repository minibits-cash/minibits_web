# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Bridge IP of the lnd container, as seen from the container running this app.
# Find it with: docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' <lnd-container>
LND_REST_HOST=
LND_REST_PORT=8080

# Hex-encoded readonly macaroon (least privilege — getinfo only needs read).
# xxd -ps -u -c 1000 ~/.lnd/data/chain/bitcoin/mainnet/readonly.macaroon
LND_MACAROON_HEX=

# Optional: base64 of lnd's tls.cert. If set, TLS is verified against it;
# if unset, the self-signed cert is accepted without verification.
# base64 -w0 ~/.lnd/tls.cert
LND_TLS_CERT_B64=
